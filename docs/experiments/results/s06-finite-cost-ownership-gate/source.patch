+
+#[test]
+fn feature_off_preserves_answers_without_collecting_solver_counts() {
+    let g = grammar();
+    let mut search = Search::new(
+        &g,
+        Request {
+            roots: vec![1],
+            equalities: vec![],
+        },
+    )
+    .unwrap();
+    let b = search.advance(1000).unwrap();
+    assert!(b.exhausted);
+    assert_eq!(b.answers.len(), 4);
+    assert_eq!(
+        chr_structural::finite::COLLECT_METRICS,
+        cfg!(feature = "metrics")
+    );
+    if !cfg!(feature = "metrics") {
+        let s = search.stats();
+        assert_eq!(
+            (
+                s.requirements,
+                s.transition_trials,
+                s.duplicate_values,
+                s.emitted,
+                s.peak_frontier
+            ),
+            (0, 0, 0, 0, 0)
+        );
+    }
+}
