+fn trace(p: &std::sync::Arc<Prepared>, q: &Query, mode: Mode) -> Vec<Step> {
+    let mut engine = p.start(q, mode).unwrap();
+    let mut events = vec![];
+    for _ in 0..100000 {
+        let event = engine.advance();
+        let done = matches!(event, Step::Exhausted);
+        events.push(event);
+        if done {
+            return events;
+        }
+    }
+    panic!("event trace cutoff");
+}
